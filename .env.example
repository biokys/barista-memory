# Copy to .env and fill in. scripts/archive.sh and scripts/deploy.sh source it.
# The daemon can run on any always-on Linux box; a Raspberry Pi is merely
# what it was built on.
GAGGIMATE_SERVER_HOST=user@server                # ssh target running the daemon
GAGGIMATE_SERVER_DIR=/home/user/barista-memory   # where it is deployed there
GAGGIMATE_SERVICES="barista-memory barista-memory-web"   # systemd units deploy.sh restarts
GAGGIMATE_HOST=192.168.1.50                      # the espresso machine; an IP, not .local (mDNS is slow)
# Optional: Home Assistant entities over MQTT (discovery). Unset = off.
# GAGGIMATE_MQTT_URL=mqtt://192.168.1.10:1883
# GAGGIMATE_MQTT_USER=
# GAGGIMATE_MQTT_PASSWORD=
# GAGGIMATE_READY_PCT=85                         # warm-up percent at which "Machine ready" turns on
# Optional: MCP over HTTP at http://<host>:8080/mcp, guarded by this bearer token. Unset = off.
# GAGGIMATE_MCP_TOKEN=
# Optional: Bluetooth receipt printer (MXW01 class) and receipt options.
# GAGGIMATE_PRINTER_MAC=48:0F:57:00:00:00
# GAGGIMATE_LANG=cs
# GAGGIMATE_WEB_URL=http://192.168.1.20:8080
# Optional: the in-app assistant (chat about shots, receipt captions). Unset = off.
# GAGGIMATE_ANTHROPIC_KEY=sk-ant-...
# GAGGIMATE_ASSISTANT_MODEL=claude-opus-5           # or claude-sonnet-5 for a cheaper one
# GAGGIMATE_ASSISTANT_EFFORT=medium                 # low | medium | high | xhigh | max
