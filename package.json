{
  "name": "barista-memory",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Remembers what the barista cannot: every shot, the beans and grind in force, and how warm the machine really was",
  "scripts": {
    "build": "tsc && cp src/db/schema.sql dist/db/schema.sql",
    "ingest": "node dist/ingest.js",
    "daemon": "node dist/daemon.js",
    "mcp": "node dist/mcp/server.js",
    "cli": "node dist/cli.js",
    "deploy": "scripts/deploy.sh",
    "web": "node dist/web/server.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "dbus-next": "^0.10.2",
    "mqtt": "^5.16.0",
    "qrcode": "^1.5.4",
    "uplot": "^1.6.32",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0"
  },
